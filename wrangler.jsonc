{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-vpn-fresh",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "5e77e69e-6499-4de1-b776-9c3aaf26258a","database_name": "nova-vpn-fresh" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "4b45351a87cb4b828ae6b7c9a88b2bfe" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
